# Required
GEMINI_API_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional Gemini tuning
GEMINI_MODEL=gemini-3.6-flash
GEMINI_STRUCTURED_MODEL=gemini-3.6-flash
GEMINI_REQUEST_TIMEOUT_MS=45000

# Production durable storage (choose ONE option)
# Option A: Upstash Redis (recommended for serverless/multi-instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Option B: persistent single-instance volume
DURABLE_FILE_STORAGE=false
REDESIGN_DATA_DIR=

# Abuse controls
ANON_NETWORK_FREE_LIMIT=12
# Only enable when a trusted reverse proxy overwrites these headers.
TRUST_PROXY_HEADERS=false
